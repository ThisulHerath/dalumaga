{
  "expo": {
    "name": "DaluMaga",
    "slug": "dalumaga",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "android": {
      "package": "lk.dalumaga.field"
    },
    "ios": {
      "bundleIdentifier": "lk.dalumaga.field"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DaluMaga to scan crate QR labels.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
