{
  "name": "dalumaga",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "turbo run build --filter=@dalumaga/shared && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "db:migrate": "pnpm --filter @dalumaga/api db:migrate",
    "db:status": "pnpm --filter @dalumaga/api db:status",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "pnpm": "10.32.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "turbo": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
